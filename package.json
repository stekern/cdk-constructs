{
  "name": "@stekern/cdk-constructs",
  "repository": {
    "type": "git",
    "url": "https://github.com/stekern/cdk-constructs.git"
  },
  "version": "0.0.0-development",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc --noEmit && tsc --project tsconfig.build.json && npm run copy-assets",
    "copy-assets": "find assets -type f -not -name '*.snap' -not -name '*.spec.ts' -not -name 'mocks.ts' -not -name 'types.ts' -exec bash -c 'path=\"{}\" && mkdir -p \"dist/${path%/*}\" && cp \"$path\" \"dist/$path\"' ';'",
    "lint": "biome check --diagnostic-level=error",
    "test": "jest"
  },
  "files": ["dist/**/*"],
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "dev",
        "channel": "alpha",
        "prerelease": true
      }
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.816.0",
    "@aws-sdk/client-kms": "3.816.0",
    "@aws-sdk/client-secrets-manager": "3.816.0",
    "@aws-sdk/client-servicediscovery": "3.816.0",
    "@aws-sdk/lib-dynamodb": "3.816.0",
    "@aws-sdk/util-dynamodb": "3.816.0",
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@octokit/types": "7.5.1",
    "@octokit/webhooks-types": "6.11.0",
    "@tsconfig/node16": "16.1.3",
    "@types/aws-lambda": "8.10.149",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.50",
    "aws-cdk": "2.1016.1",
    "aws-cdk-lib": "2.177.0",
    "aws-sdk": "2.1692.0",
    "constructs": "10.4.2",
    "esbuild": "0.25.4",
    "husky": "8.0.3",
    "jest": "29.7.0",
    "semantic-release": "24.2.4",
    "ts-jest": "29.3.4",
    "tsx": "4.19.4",
    "typedoc": "0.28.4",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0"
  }
}
