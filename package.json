{
  "name": "@stekern/cdk-constructs",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stekern/cdk-constructs.git"
  },
  "version": "0.0.0-development",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc --noEmit && tsc --project tsconfig.build.json && npm run copy-assets",
    "copy-assets": "find assets -type f -not -name '*.snap' -not -name '*.spec.ts' -not -name 'mocks.ts' -not -name 'types.ts' -exec bash -c 'path=\"{}\" && mkdir -p \"dist/${path%/*}\" && cp \"$path\" \"dist/$path\"' ';'",
    "lint": "biome check --diagnostic-level=error",
    "lint:fix": "biome check --fix",
    "test": "jest"
  },
  "bin": {
    "generate-cdk-snapshots": "bin/generate-cdk-snapshots.js"
  },
  "files": ["dist/**/*", "bin"],
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "dev",
        "channel": "alpha",
        "prerelease": true
      }
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.982.0",
    "@aws-sdk/client-kms": "3.982.0",
    "@aws-sdk/client-secrets-manager": "3.982.0",
    "@aws-sdk/client-servicediscovery": "3.982.0",
    "@aws-sdk/lib-dynamodb": "3.982.0",
    "@aws-sdk/util-dynamodb": "3.982.0",
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "@octokit/types": "7.5.1",
    "@octokit/webhooks-types": "6.11.0",
    "@tsconfig/node24": "24.0.5",
    "@types/aws-lambda": "8.10.163",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.15",
    "aws-cdk": "2.1110.0",
    "aws-cdk-lib": "2.242.0",
    "aws-sdk": "2.1693.0",
    "constructs": "10.5.1",
    "esbuild": "0.28.2",
    "husky": "8.0.3",
    "jest": "29.7.0",
    "semantic-release": "24.2.9",
    "ts-jest": "29.4.12",
    "tsx": "4.21.0",
    "typedoc": "0.28.17",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0"
  }
}
